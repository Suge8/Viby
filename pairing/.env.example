# 必填：broker 自己监听的地址与公网访问地址
PAIRING_HOST=0.0.0.0
PAIRING_PORT=8787
PAIRING_PUBLIC_URL=https://pair.example.com

# 必填：本地 Hub 创建 pairing session 时调用 broker 的共享 secret
PAIRING_CREATE_TOKEN=replace-with-strong-secret

# 强烈建议：生产固定 PWA manifest cookie 签名 secret，避免 broker 重启后已安装入口失效
PAIRING_MANIFEST_COOKIE_SECRET=replace-with-stable-random-secret

# 强烈建议：生产公网场景至少配 Redis
# 不配时会退回进程内存态；单进程临时测试可以，但重启会丢 pairing 状态
PAIRING_REDIS_URL=redis://127.0.0.1:6379

# STUN 只参与 ICE 直连探测；客户端各自向公网 STUN 发 outbound UDP，跟 broker 服务器入站 UDP 无关。
# 选三个不同网络的可达 STUN：cloudflare anycast 全球稳定、miwifi 国内运营商友好、nextcloud:443 走 HTTPS 端口对受限网络友好。
# 不要再放 stun.l.google.com（中国大陆通常拿不到回包）或仅指向本机 broker 的 STUN（云上 hypervisor 默认不放 unsolicited inbound UDP，那个 STUN 等于摆设）。
# 失败时 sealed WSS relay (`/pairings/:id/tunnel`) 兜底，业务面不依赖 P2P。
PAIRING_STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.miwifi.com:3478,stun:stun.nextcloud.com:443

# 可选：保持默认即可，只有你明确知道要调时再改
PAIRING_SESSION_TTL_SECONDS=2592000
PAIRING_TICKET_TTL_SECONDS=600
PAIRING_RECONNECT_CHALLENGE_TTL_SECONDS=60
PAIRING_DISCONNECT_GRACE_SECONDS=300
