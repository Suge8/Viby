# Optional headless / server overrides.
# Desktop users normally leave this file alone.

# Internal Hub owner secret. Auto-generated into ~/.viby/settings.toml when omitted.
# VIBY_HUB_OWNER_TOKEN=replace-with-owner-token

VIBY_LISTEN_HOST=0.0.0.0
VIBY_LISTEN_PORT=37173

# Public broker defaults to https://pair.viby.run.
# Set these only for a private broker deployment.
# PAIRING_BROKER_URL=https://pair.example.com
# PAIRING_CREATE_TOKEN=replace-with-strong-secret
