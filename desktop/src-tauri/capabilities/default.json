{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Minimal main-window capability set for the desktop control panel.",
    "windows": ["main"],
    "permissions": [
        "core:event:allow-listen",
        "core:event:allow-unlisten",
        "core:window:allow-start-dragging",
        "updater:allow-check",
        "updater:allow-download-and-install",
        "allow-get-hub-snapshot",
        "allow-start-hub",
        "allow-stop-hub",
        "allow-open-preferred-url",
        "allow-open-url",
        "allow-copy-text",
        "allow-get-pairing-session",
        "allow-clear-pairing-session",
        "allow-create-pairing-session",
        "allow-approve-pairing-session",
        "allow-refresh-pairing-session",
        "allow-delete-pairing-session"
    ]
}
