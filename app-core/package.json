{
    "name": "@viby/app-core",
    "private": true,
    "version": "0.2.0",
    "description": "Viby AppCore binary and provider runtime implementation",
    "author": "Viby",
    "license": "AGPL-3.0-only",
    "type": "module",
    "homepage": "https://github.com/Suge8/Viby",
    "bugs": "https://github.com/Suge8/Viby/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Suge8/Viby.git",
        "directory": "app-core"
    },
    "imports": {
        "#embedded-assets": {
            "bun": "./src/runtime/embeddedAssets.bun.ts",
            "default": "./src/runtime/embeddedAssets.stub.ts"
        }
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build:app-core": "bun run scripts/build-executable.ts --with-web-assets --name viby-app-core",
        "build:app-core:all": "bun run scripts/build-executable.ts --with-web-assets --all --name viby-app-core",
        "tools:unpack": "bun run scripts/unpack-tools.ts",
        "test": "bun run tools:unpack && vitest run",
        "test:win": "vitest run",
        "dev": "bun src/appCoreBootstrap.ts",
        "dev:local-server": "bun --env-file .env.dev-local-server src/appCoreBootstrap.ts",
        "dev:integration-test-env": "bun --env-file .env.integration-test src/appCoreBootstrap.ts"
    },
    "dependencies": {
        "@github/copilot-sdk": "^0.2.1",
        "@viby/protocol": "workspace:*",
        "axios": "^1.13.2",
        "chalk": "^5.6.2",
        "cross-spawn": "^7.0.6",
        "ps-list": "^9.0.0",
        "qrcode": "^1.5.4",
        "tar": "^7.5.2",
        "yaml": "^2.8.2",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@types/cross-spawn": "^6.0.6",
        "@types/node": ">=25",
        "@types/ps-list": "^6.2.1",
        "@types/qrcode": "^1.5.6",
        "bun-types": "^1.3.11",
        "dotenv": "^17.2.3",
        "typescript": "^5.9.3",
        "vitest": "^4.0.16"
    },
    "resolutions": {
        "whatwg-url": "14.2.0",
        "parse-path": "7.0.3",
        "@types/parse-path": "7.0.3"
    },
    "packageManager": "bun@1.3.11"
}
